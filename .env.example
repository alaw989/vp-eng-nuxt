# Environment Variables for VP Associates Nuxt 3 Website
# Copy this file to .env for local development

# Public: Site URL (used for sitemap, canonical URLs, OG tags)
NUXT_PUBLIC_SITE_URL=https://vp-associates.com

# Public: WordPress REST API URL (for fetching dynamic content)
NUXT_PUBLIC_WP_API_URL=https://www.vp-associates.com/wp-json/wp/v2

# Private: WordPress API URL (server-side only)
WP_API_URL=https://www.vp-associates.com/wp-json/wp/v2

# Contact form endpoint (optional; defaults to /api/contact, which nginx forwards to
# the whiteboard's Laravel app). Recipients are set in that app's .env.
# NUXT_PUBLIC_CONTACT_ENDPOINT=https://staging-whiteboard.vp-associates.com/api/contact

# Google Analytics 4 Measurement ID (optional)
# Leave empty to disable analytics tracking
# Get your measurement ID from https://analytics.google.com/
# Example: NUXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NUXT_PUBLIC_GA_MEASUREMENT_ID=

# Node environment
NODE_ENV=production

# Port for development server (optional, defaults to 3000)
PORT=3000
